---
import '../styles/global.css';

interface Props {
	title: string;
	activeNav: 'top' | 'profile' | 'blog' | 'downloads' | 'links';
	showSecondaryGlow?: boolean;
}

const { title, activeNav, showSecondaryGlow = true } = Astro.props;
const navItems = [
	{ label: 'Top', href: '/', key: 'top' },
	{ label: 'Profile', href: '/profile', key: 'profile' },
	{ label: 'Blog', href: '/posts', key: 'blog' },
	{ label: 'Downloads', href: '/downloads', key: 'downloads' },
	{ label: 'Link', href: '/links', key: 'links' },
] as const;
const bodyClass = 'bg-bg text-text min-h-screen flex flex-col font-sans text-[13px] sm:text-[14px] antialiased selection:bg-emerald-500/20 selection:text-emerald-300 relative w-full max-w-full';
const navLinkClass = 'px-2 py-1.5 sm:px-3.5 sm:py-2 rounded-lg hover:bg-white/[0.05] transition-all';
---

<html lang="ja" class="w-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} | RedFalcon72</title>
		<link rel="icon" href="/favicon.jpeg" type="image/jpeg" />
		<link rel="shortcut icon" href="/favicon.jpeg" />
		<link rel="apple-touch-icon" href="/favicon.jpeg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class={bodyClass}>
		<div class="fixed -top-40 left-1/2 -translate-x-1/2 w-[300px] sm:w-[1000px] h-[300px] sm:h-[500px] bg-gradient-to-tr from-emerald-600/15 via-teal-500/10 to-indigo-600/15 blur-[100px] sm:blur-[140px] pointer-events-none -z-10 rounded-full"></div>
		{showSecondaryGlow && <div class="fixed top-1/2 right-0 w-[250px] sm:w-[500px] h-[250px] sm:h-[500px] bg-emerald-500/5 blur-[100px] sm:blur-[160px] pointer-events-none -z-10 rounded-full"></div>}

		<header class="sticky top-0 z-50 w-full bg-bg/90 backdrop-blur-md border-b border-border/80 px-3 sm:px-16 py-3.5 sm:py-5 flex justify-between items-center shrink-0 relative" aria-label="メインヘッダー">
			<a href="/" class="font-mono text-base sm:text-lg font-bold tracking-wider text-text hover:opacity-80 transition-opacity flex items-center gap-1.5 sm:gap-3 py-1 shrink-0">
				<span class="w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-emerald-400 shrink-0 animate-pulse shadow-[0_0_8px_rgba(52,211,153,0.8)]"></span>
				<span class="sm:hidden">RF72</span>
				<span class="hidden sm:inline">RedFalcon72</span>
			</a>
			<button type="button" class="sm:hidden w-10 h-10 rounded-lg border border-border text-muted sm:hover:text-text sm:hover:bg-white/[0.05] transition-colors flex items-center justify-center" aria-label="メニューを開く" aria-expanded="false" aria-controls="mobile-navigation" data-menu-toggle>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
					<path d="M4 6h16M4 12h16M4 18h16" />
				</svg>
			</button>
			<nav id="mobile-navigation" class="fixed inset-0 z-[60] w-screen h-screen bg-black flex flex-col items-center justify-center gap-4 p-6 opacity-0 invisible pointer-events-none transition-opacity sm:static sm:z-auto sm:w-auto sm:h-auto sm:p-0 sm:bg-transparent sm:flex-row sm:items-center sm:gap-2 sm:opacity-100 sm:visible sm:pointer-events-auto text-base font-mono shrink-0" aria-label="メインナビゲーション">
				<button type="button" class="sm:hidden absolute top-4 right-4 w-10 h-10 rounded-lg border border-border text-muted sm:hover:text-text sm:hover:bg-white/[0.05] transition-colors flex items-center justify-center" aria-label="メニューを閉じる" data-menu-close>
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
						<path d="M6 6l12 12M18 6L6 18" />
					</svg>
				</button>
				{navItems.map((item) => (
					<a href={item.href} class={`${navLinkClass} flex w-full max-w-xs items-center justify-center border border-border bg-surface py-3 text-center sm:inline sm:w-auto sm:max-w-none sm:border-0 sm:bg-transparent ${activeNav === item.key ? 'text-text' : 'text-muted hover:text-text'}`}>{item.label}</a>
				))}
			</nav>
		</header>

		<slot />

		<footer class="w-full px-4 sm:px-16 py-6 flex justify-between items-center text-xs font-mono text-muted border-t border-border/60 shrink-0">
			<span>RedFalcon72 — Developer Portal</span>
			<span>© 2026</span>
		</footer>

		<script>
			const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
			const closeButton = document.querySelector<HTMLButtonElement>('[data-menu-close]');
			const mobileNavigation = document.querySelector<HTMLElement>('#mobile-navigation');

			if (menuButton && mobileNavigation) {
				const closeMenu = () => {
					mobileNavigation.classList.add('opacity-0', 'invisible', 'pointer-events-none');
					menuButton.setAttribute('aria-expanded', 'false');
					menuButton.setAttribute('aria-label', 'メニューを開く');
				};

				menuButton.addEventListener('click', () => {
					const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
					mobileNavigation.classList.toggle('opacity-0', isOpen);
					mobileNavigation.classList.toggle('invisible', isOpen);
					mobileNavigation.classList.toggle('pointer-events-none', isOpen);
					menuButton.setAttribute('aria-expanded', String(!isOpen));
					menuButton.setAttribute('aria-label', isOpen ? 'メニューを開く' : 'メニューを閉じる');
				});
				closeButton?.addEventListener('click', closeMenu);

				document.addEventListener('click', (event) => {
					if (!event.target || (event.target instanceof Node && !mobileNavigation.contains(event.target) && !menuButton.contains(event.target))) {
						closeMenu();
					}
				});

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') closeMenu();
				});
			}
		</script>
	</body>
</html>
