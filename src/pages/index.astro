---
import '../styles/global.css';

const posts = [
  { title: "Astro + Tailwind CSSで構築する個人サイトの技術選定", date: "2026.09.10", slug: "tech-stack", category: "Architecture" },
  { title: "C言語のメモリ管理で詰まったポイントと解決策", date: "2026.09.01", slug: "c-memory", category: "Low-Level" },
];

const downloads = [
  { name: "tool_1", desc: "説明", lang: "Python", stars: "v0.0.0" },
  { name: "tool_2", desc: "説明", lang: "C", stars: "v0.0.0" },
];
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>RedFalcon72</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-bg text-text min-h-screen flex flex-col font-sans text-[14px] antialiased selection:bg-emerald-500/20 selection:text-emerald-300 relative overflow-x-hidden">

		<!-- 背景発光 -->
		<div class="fixed -top-40 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-tr from-emerald-600/15 via-teal-500/10 to-indigo-600/15 blur-[140px] pointer-events-none -z-10 rounded-full"></div>
		<div class="fixed top-1/2 right-0 w-[500px] h-[500px] bg-emerald-500/5 blur-[160px] pointer-events-none -z-10 rounded-full"></div>

		<!-- 1. ヘッダー (大型化＆アクセシビリティ強化) -->
		<header class="sticky top-0 z-50 w-full bg-bg/90 backdrop-blur-md border-b border-border/80 px-6 sm:px-16 py-6 flex justify-between items-center shrink-0" aria-label="メインヘッダー">
			<a href="/" class="font-mono text-base sm:text-lg font-bold tracking-wider text-text hover:opacity-80 transition-opacity flex items-center gap-3 py-1">
				<span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0"></span>
				RedFalcon72
			</a>
			<nav class="flex items-center gap-1 sm:gap-4 text-base font-mono" aria-label="メインナビゲーション">
				<a href="/" class="px-3.5 py-2 rounded-xl text-text hover:text-emerald-400 hover:bg-white/[0.05] transition-all">Top</a>
				<a href="/profile" class="px-3.5 py-2 rounded-xl text-muted hover:text-text hover:bg-white/[0.05] transition-all">Profile</a>
				<a href="/posts" class="px-3.5 py-2 rounded-xl text-muted hover:text-text hover:bg-white/[0.05] transition-all">Blog</a>
				<a href="/downloads" class="px-3.5 py-2 rounded-xl text-muted hover:text-text hover:bg-white/[0.05] transition-all">Downloads</a>
			</nav>
		</header>

		<!-- 2. メインコンテンツ領域 -->
		<main class="w-full flex-1 px-6 sm:px-16 pt-8 pb-12 space-y-20">

			<!-- ヒーロー -->
			<section class="w-full" aria-label="ヒーロー">
				<div class="relative w-full h-[280px] sm:h-[420px] rounded-3xl bg-surface overflow-hidden flex flex-col justify-end p-8 sm:p-14 shadow-2xl">
					
					<!-- 生成した画像の埋め込み -->
					<img src="/hero_image01.jpeg" alt="Hero Background" class="absolute inset-0 w-full h-full object-cover opacity-70" />

					<!-- 暗がりグラデーション -->
					<div class="absolute inset-0 bg-gradient-to-t from-bg via-bg/50 to-transparent"></div>
					
					<!-- テキスト表示エリア -->
					<div class="relative z-10 w-full flex flex-col sm:flex-row sm:items-end justify-between gap-6">
						<div class="space-y-2">
							<span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-mono font-medium backdrop-blur-md">
								Information Science & Computer Engineering
							</span>
							<h1 class="text-4xl sm:text-6xl font-['Plus_Jakarta_Sans'] font-extrabold text-text tracking-tight leading-none">
								RedFalcon72 <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent">— Official</span>
							</h1>
						</div>
					</div>

				</div>
			</section>

			<!-- 01 / Profile セクション -->
			<section class="w-full space-y-10" aria-label="プロフィール">
				<div class="flex items-center gap-4">
					<span class="text-xs font-mono text-emerald-400 font-semibold tracking-widest uppercase">01 / Profile</span>
					<div class="h-[1px] w-full bg-gradient-to-r from-emerald-500/30 via-border/40 to-transparent"></div>
				</div>
				
				<div class="flex flex-col lg:flex-row items-start gap-10 lg:gap-16">
					<!-- 左: 大型画像フレーム -->
					<div class="relative p-1 rounded-3xl bg-gradient-to-b from-emerald-500/30 via-teal-500/10 to-transparent flex-shrink-0 shadow-2xl">
						<div class="w-60 h-60 sm:w-80 sm:h-80 rounded-[22px] bg-surface overflow-hidden relative">
							<img
								src="/icon.jpeg"
								alt="RedFalcon72 Profile"
								class="w-full h-full object-cover"
							/>
						</div>
					</div>

					<!-- 右: 自己紹介領域 -->
					<div class="space-y-6 w-full pt-2">
						<div class="space-y-2">
							<h3 class="text-5xl sm:text-7xl font-['Plus_Jakarta_Sans'] font-extrabold text-text tracking-tight">
								<span class="bg-gradient-to-r from-red-500 via-rose-400 to-orange-400 bg-clip-text text-transparent">RedFalcon72</span>
							</h3>
							<p class="text-lg font-mono bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent font-medium">
								Computer Science Student
							</p>
						</div>
						
						<p class="text-base text-muted leading-relaxed max-w-5xl font-normal">
							機械学習・データ分析・C言語の基礎を中心に学習中。自作ツールの配布、開発実績、および日々の技術メモを蓄積・公開するための個人Web拠点。
						</p>

						<!-- ステータスタグ -->
						<div class="flex flex-wrap gap-3 pt-2 font-mono text-xs">
							<span class="px-3 py-1.5 rounded-lg bg-surface border border-border text-muted flex items-center gap-2">
								<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Location: Japan
							</span>
							<span class="px-3 py-1.5 rounded-lg bg-surface border border-border text-muted">
								Focus: ML / Data Analysis / C
							</span>
						</div>
					</div>
				</div>
			</section>

			<!-- 02 / Latest Blog セクション -->
			<section class="w-full space-y-6" aria-label="最新ブログ記事">
				<div class="flex justify-between items-center gap-4">
					<div class="flex items-center gap-4 w-full">
						<span class="text-xs font-mono text-emerald-400 font-semibold tracking-widest uppercase flex-shrink-0">02 / Latest Blog</span>
						<div class="h-[1px] w-full bg-gradient-to-r from-emerald-500/30 via-border/40 to-transparent"></div>
					</div>
					<a href="/posts" class="text-xs font-mono text-muted hover:text-text transition-colors flex-shrink-0 ml-4">全ての記事 →</a>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-4">
					<!-- 最新記事 -->
					<a href={`/posts/${posts[0].slug}`} class="group relative rounded-3xl bg-surface border border-border p-8 flex flex-col justify-end min-h-[260px] overflow-hidden">
						<div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/[0.06] blur-[100px] pointer-events-none"></div>
						<span class="text-[11px] font-mono text-emerald-400 mb-3">{posts[0].category}</span>
						<h3 class="text-2xl font-['Plus_Jakarta_Sans'] font-bold text-text leading-snug group-hover:text-emerald-300 transition-colors max-w-md">
							{posts[0].title}
						</h3>
						<span class="text-xs font-mono text-muted mt-4">{posts[0].date}</span>
					</a>

					<!-- 残りの記事 -->
					<div class="flex flex-col divide-y divide-border">
						{posts.slice(1).map((post) => (
							<a href={`/posts/${post.slug}`} class="group py-5 first:pt-0 flex flex-col gap-1.5">
								<div class="flex items-center justify-between">
									<span class="text-[11px] font-mono text-muted">{post.category}</span>
									<span class="text-[11px] font-mono text-muted">{post.date}</span>
								</div>
								<h4 class="text-sm font-medium text-text group-hover:text-emerald-300 transition-colors leading-snug">
									{post.title}
								</h4>
							</a>
						))}
					</div>
				</div>
			</section>

			<!-- 03 / Downloads セクション -->
			<section class="w-full space-y-6" aria-label="ダウンロードコンテンツ">
				<div class="flex justify-between items-center gap-4">
					<div class="flex items-center gap-4 w-full">
						<span class="text-xs font-mono text-emerald-400 font-semibold tracking-widest uppercase flex-shrink-0">03 / Downloads</span>
						<div class="h-[1px] w-full bg-gradient-to-r from-emerald-500/30 via-border/40 to-transparent"></div>
					</div>
					<a href="/downloads" class="text-xs font-mono text-muted hover:text-text transition-colors flex-shrink-0 ml-4">全てのツール →</a>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					{downloads.map((item) => (
						<div class="rounded-2xl bg-[#050506] border border-border overflow-hidden">
							<div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-border/70">
								<span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
								<span class="ml-auto text-[10px] font-mono text-muted">{item.stars}</span>
							</div>
							<div class="p-5 space-y-3 font-mono text-xs">
								<p class="text-emerald-400">
									$ <span class="text-text">{item.name}</span>
								</p>
								<p class="text-muted leading-relaxed"># {item.desc}</p>
								<p class="text-muted/70">lang: {item.lang}</p>
							</div>
						</div>
					))}
				</div>
			</section>

			<!-- 04 / Links セクション -->
			<section class="w-full space-y-6" aria-label="リンク">
				<div class="flex items-center gap-4 w-full">
					<span class="text-xs font-mono text-emerald-400 font-semibold tracking-widest uppercase flex-shrink-0">04 / Links</span>
					<div class="h-[1px] w-full bg-gradient-to-r from-emerald-500/30 via-border/40 to-transparent"></div>
				</div>

				<div class="flex flex-wrap gap-x-10 gap-y-2 font-mono text-sm pt-2">
					<a href="https://github.com/RedFalcon72" target="_blank" rel="noopener noreferrer" class="text-muted hover:text-text transition-colors flex items-center gap-1.5">
						GitHub ↗
					</a>
					<a href="#" class="text-muted hover:text-text transition-colors flex items-center gap-1.5">
						X ↗
					</a>
				</div>
			</section>

		</main>

		<!-- 3. フッター -->
		<footer class="w-full px-6 sm:px-16 py-6 flex justify-between items-center text-xs font-mono text-muted border-t border-border/60 shrink-0">
			<span>RedFalcon72 — Developer Portal</span>
			<span>© 2026</span>
		</footer>

	</body>
</html>