---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts');
const posts = allPosts
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 6);

const hero = {
	badge: 'Information Science & Computer Engineering',
	name: 'RedFalcon72',
	suffix: '— Official',
};

const profile = {
	name: 'RedFalcon72',
	role: 'Computer Science Student',
	description: '機械学習・データ分析・C言語の基礎を中心に学習中。自作ツールの配布、開発実績、および日々の技術メモを蓄積・公開するための個人Web拠点。',
	location: 'Japan',
	focus: 'ML / Data Analysis / C',
};

const downloads = [
	{ name: "tool_1", desc: "説明", lang: "Python", stars: "v0.0.0" },
	{ name: "tool_2", desc: "説明", lang: "C", stars: "v0.0.0" },
];

const links = [
	{ label: 'GitHub', url: 'https://github.com/RedFalcon72', external: true },
	{ label: 'X', url: 'https://x.com/RFalcon7254127', external: true },
];
---

	<BaseLayout title="RedFalcon72" activeNav="top">
		<!-- メインコンテンツ領域 -->
		<main class="w-full max-w-full flex-1 px-4 sm:px-16 pt-6 sm:pt-8 pb-12 space-y-16 sm:space-y-20 overflow-x-hidden">

			<!-- ヒーロー -->
			<section class="w-full" aria-label="ヒーロー">
				<div class="relative w-full h-[220px] sm:h-[420px] rounded-2xl sm:rounded-3xl bg-surface overflow-hidden flex flex-col justify-end p-5 sm:p-14 shadow-2xl">

					<img src="/hero_image01.jpeg" alt="Hero Background" class="absolute inset-0 w-full h-full object-cover opacity-70" />

					<div class="relative z-10 w-full flex flex-col sm:flex-row sm:items-end justify-between gap-3 sm:gap-6">
						<div class="space-y-1.5 sm:space-y-2">
							<span class="inline-flex items-center gap-2 px-2.5 py-0.5 sm:py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[10px] sm:text-xs font-mono font-medium backdrop-blur-md">
								{hero.badge}
							</span>
							<h1 class="text-2xl sm:text-6xl font-['Plus_Jakarta_Sans'] font-extrabold text-text tracking-tight leading-none break-all">
								{hero.name} <span class="bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400 bg-clip-text text-transparent block sm:inline mt-1 sm:mt-0">{hero.suffix}</span>
							</h1>
						</div>
					</div>

				</div>
			</section>

			<!-- 01 / Profile セクション -->
			<section class="w-full space-y-8 sm:space-y-10" aria-label="プロフィール">
				<div class="flex justify-between items-center gap-4">
					<div class="flex items-center gap-4 w-full">
						<span class="text-xs font-mono text-emerald-400 font-semibold tracking-widest uppercase flex-shrink-0">01 / Profile</span>
						<div class="h-[1px] w-full bg-gradient-to-r from-emerald-500/30 via-border/40 to-transparent"></div>
					</div>
					<a href="/profile" class="text-xs font-mono text-muted hover:text-text transition-colors flex-shrink-0 ml-2">全てのプロフィール →</a>
				</div>

				<div class="flex flex-col lg:flex-row items-center lg:items-start gap-8 lg:gap-16">
					<div class="relative p-1 rounded-3xl bg-gradient-to-b from-emerald-500/30 via-teal-500/10 to-transparent flex-shrink-0 shadow-2xl mx-auto lg:mx-0">
						<div class="w-48 h-48 sm:w-80 sm:h-80 rounded-[22px] bg-surface overflow-hidden relative">
							<img
								src="/icon.jpeg"
								alt="RedFalcon72 Profile"
								class="w-full h-full object-cover"
							/>
						</div>
					</div>

					<div class="space-y-5 sm:space-y-6 w-full pt-2 text-left">
						<div class="space-y-2">
							<h3 class="text-3xl sm:text-7xl font-['Plus_Jakarta_Sans'] font-extrabold text-text tracking-tight break-all">
								<span class="bg-gradient-to-r from-red-500 via-rose-400 to-orange-400 bg-clip-text text-transparent">{profile.name}</span>
							</h3>
							<p class="text-base sm:text-lg font-mono bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent font-medium">
								{profile.role}
							</p>

							<div class="flex flex-wrap gap-2.5 sm:gap-3 pt-1 font-mono text-xs">
								<span class="px-3 py-1.5 rounded-lg bg-surface border border-border text-muted flex items-center gap-2">
									<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Location: {profile.location}
								</span>
								<span class="px-3 py-1.5 rounded-lg bg-surface border border-border text-muted">
									Focus: {profile.focus}
								</span>
							</div>
						</div>

						<p class="text-sm sm:text-base text-muted leading-relaxed max-w-5xl font-normal">
							{profile.description}
						</p>

						<div class="flex flex-wrap gap-2.5 pt-1 font-mono text-xs">
							{links.map((link) => (
								<a
									href={link.url}
									target={link.external ? '_blank' : undefined}
									rel={link.external ? 'noopener noreferrer' : undefined}
									class="inline-flex items-center gap-2 rounded-lg border border-border bg-surface px-3.5 py-2 text-muted transition-colors hover:border-emerald-500/50 hover:text-emerald-300"
								>
									{link.label} <span aria-hidden="true">↗</span>
								</a>
							))}
						</div>
					</div>
				</div>
			</section>

			<!-- 02 / Latest Blog セクション -->
			<section class="w-full space-y-6" aria-label="最新ブログ記事">
				<div class="flex justify-between items-center gap-4">
					<div class="flex items-center gap-4 w-full">
						<span class="text-xs font-mono text-emerald-400 font-semibold tracking-widest uppercase flex-shrink-0">02 / Latest Blog</span>
						<div class="h-[1px] w-full bg-gradient-to-r from-emerald-500/30 via-border/40 to-transparent"></div>
					</div>
					<a href="/posts" class="text-xs font-mono text-muted hover:text-text transition-colors flex-shrink-0 ml-2">全ての記事 →</a>
				</div>

				{posts.length > 0 && (
					<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-4">
						<!-- 最新記事 -->
						<a href={`/posts/${posts[0].id}`} class="group relative rounded-2xl sm:rounded-3xl bg-surface border border-border p-5 sm:p-8 flex flex-col justify-end min-h-[200px] sm:min-h-[260px] overflow-hidden">
							<img src="/note.jpeg" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-55 transition-transform duration-700 group-hover:scale-105" />
							<div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/[0.06] blur-[100px] pointer-events-none"></div>
							<div class="relative z-10">
								<span class="text-[11px] font-mono text-emerald-400 mb-2 sm:mb-3 block">{posts[0].data.category}</span>
								<h3 class="text-lg sm:text-2xl font-['Plus_Jakarta_Sans'] font-bold text-text leading-snug group-hover:text-emerald-300 transition-colors max-w-md">
									{posts[0].data.title}
								</h3>
								<span class="text-xs font-mono text-muted mt-3 sm:mt-4 block">{posts[0].data.date.toLocaleDateString('ja-JP').replaceAll('/', '.')}</span>
							</div>
						</a>

						<!-- 残りの記事 -->
						<div class="flex flex-col divide-y divide-border">
							{posts.slice(1).map((post) => (
								<a href={`/posts/${post.id}`} class="group py-4 sm:py-5 first:pt-0 flex flex-col gap-1.5">
									<div class="flex items-center justify-between">
										<span class="text-[11px] font-mono text-muted">{post.data.category}</span>
										<span class="text-[11px] font-mono text-muted">{post.data.date.toLocaleDateString('ja-JP').replaceAll('/', '.')}</span>
									</div>
									<h4 class="text-sm font-medium text-text group-hover:text-emerald-300 transition-colors leading-snug">
										{post.data.title}
									</h4>
								</a>
							))}
						</div>
					</div>
				)}
			</section>

			<!-- 03 / Downloads セクション -->
			<section class="w-full space-y-6" aria-label="ダウンロードコンテンツ">
				<div class="flex justify-between items-center gap-4">
					<div class="flex items-center gap-4 w-full">
						<span class="text-xs font-mono text-emerald-400 font-semibold tracking-widest uppercase flex-shrink-0">03 / Downloads</span>
						<div class="h-[1px] w-full bg-gradient-to-r from-emerald-500/30 via-border/40 to-transparent"></div>
					</div>
					<a href="/downloads" class="text-xs font-mono text-muted hover:text-text transition-colors flex-shrink-0 ml-2">全てのツール →</a>
				</div>

				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					{downloads.map((item) => (
						<div class="rounded-2xl bg-[#050506] border border-border overflow-hidden">
							<div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-border/70">
								<span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
								<span class="w-2.5 h-2.5 rounded-full bg-white/10"></span>
								<span class="ml-auto text-[10px] font-mono text-muted">{item.stars}</span>
							</div>
							<div class="p-4 sm:p-5 space-y-3 font-mono text-xs">
								<p class="text-emerald-400">
									$ <span class="text-text">{item.name}</span>
								</p>
								<p class="text-muted leading-relaxed"># {item.desc}</p>
								<p class="text-muted/70">lang: {item.lang}</p>
							</div>
						</div>
					))}
				</div>
			</section>

		</main>

	</BaseLayout>