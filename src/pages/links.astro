---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
	{
		label: 'GitHub',
		description: 'ソースコードや開発中のプロジェクト',
		url: 'https://github.com/RedFalcon72',
	},
	{
		label: 'X',
		description: '日々の活動や技術メモ',
		url: 'https://x.com/RFalcon7254127',
	},
	{
		label: 'Email',
		description: 'お問い合わせ・ご連絡',
		url: 'mailto:contact@example.com',
	},
];

const rainDrops = Array.from({ length: 24 }, (_, index) => {
	const left = (index * 43) % 103 - 2;
	const delay = -((index * 0.37) % 5);
	const duration = 3.5 + (index % 5) * 0.55;
	const height = 22 + (index % 6) * 9;
	return { left, delay, duration, height, code: '01 10 11 00 01 10 01 11' };
});
---

<BaseLayout title="Link" activeNav="links">
	<main class="relative isolate w-full max-w-full flex-1 overflow-hidden px-4 pt-10 pb-12 sm:px-16 sm:pt-14">
		<div class="link-background pointer-events-none fixed inset-0 z-0" aria-hidden="true">
			<div class="aurora-layer absolute -inset-1/2"></div>
			<div class="grid-layer absolute -inset-1/2"></div>
			<div class="particle-layer absolute inset-0"></div>
			<div class="rain-layer absolute inset-0">
				{rainDrops.map((drop, i) => (
					<span
						class="rain-drop"
						style={`left:${drop.left}%; animation-delay:${drop.delay}s; animation-duration:${drop.duration}s; height:${drop.height}px;`}
					></span>
				))}
				{rainDrops.map((drop, i) => (
					<span
						class="code-rain"
						style={`left:${drop.left}%; animation-delay:${drop.delay}s; animation-duration:${drop.duration}s;`}
					>{drop.code}</span>
				))}
			</div>
		</div>
		<div class="relative z-10 w-full max-w-xl mx-auto space-y-8 sm:space-y-10">
			<div class="absolute -top-10 left-1/2 -translate-x-1/2 w-56 h-32 bg-emerald-500/10 blur-3xl pointer-events-none"></div>
			<section class="relative w-full space-y-5 text-center" aria-label="リンク">
				<div class="flex justify-center">
					<div class="relative p-1 rounded-full bg-gradient-to-br from-emerald-300 via-teal-500 to-cyan-500 shadow-[0_0_30px_rgba(52,211,153,0.2)]">
						<img src="/icon.jpeg" alt="RedFalcon72" class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover border-4 border-bg" />
					</div>
				</div>
				<div class="space-y-2">
					<div class="flex items-center justify-center gap-2">
						<h1 class="text-3xl sm:text-5xl font-['Plus_Jakarta_Sans'] font-extrabold text-text tracking-tight">RedFalcon72</h1>
						<span class="text-emerald-400 text-lg" aria-label="認証済み">●</span>
					</div>
					<p class="text-sm font-mono text-emerald-300">@RedFalcon72</p>
					<p class="text-sm sm:text-base text-muted leading-relaxed">Computer Science Student<br />機械学習・データ分析・C言語を学習中</p>
				</div>
			</section>

		<section class="relative flex flex-col gap-3" aria-label="リンク一覧">
			{links.map((link) => (
				<a href={link.url} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined} class="group min-h-16 rounded-2xl bg-surface/90 border border-border/90 px-5 py-4 flex items-center gap-4 shadow-lg shadow-black/10 hover:-translate-y-0.5 hover:border-emerald-400/60 hover:bg-emerald-500/[0.06] hover:shadow-emerald-500/10 transition-all duration-200">
					<span class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-mono text-sm flex-shrink-0 group-hover:bg-emerald-400 group-hover:text-bg transition-colors">↗</span>
					<span class="flex-1 min-w-0 text-left">
						<strong class="block text-sm sm:text-base font-semibold text-text">{link.label}</strong>
						<span class="block mt-1 text-xs text-muted truncate">{link.description}</span>
					</span>
					<span class="text-muted group-hover:text-emerald-300 transition-colors text-lg" aria-hidden="true">↗</span>
				</a>
			))}
		</section>
		</div>
	</main>

	<style>
		.aurora-layer {
			background: linear-gradient(115deg, transparent 25%, rgb(16 185 129 / 0.1) 42%, rgb(6 182 212 / 0.08) 50%, transparent 67%);
			background-size: 220% 220%;
			filter: blur(40px);
			animation: aurora-drift 18s ease-in-out infinite alternate;
		}

		.grid-layer {
			background-image: linear-gradient(rgb(52 211 153 / 0.055) 1px, transparent 1px), linear-gradient(90deg, rgb(52 211 153 / 0.055) 1px, transparent 1px);
			background-size: 56px 56px;
			mask-image: linear-gradient(to bottom, black, transparent 85%);
			transform: rotate(-8deg) scale(1.4);
			animation: grid-drift 24s linear infinite;
		}

		.particle-layer {
			background-image: radial-gradient(circle, rgb(110 231 183 / 0.35) 0 1px, transparent 1.5px), radial-gradient(circle, rgb(103 232 249 / 0.2) 0 1px, transparent 1.5px);
			background-position: 0 0, 35px 70px;
			background-size: 130px 130px, 190px 190px;
			mask-image: linear-gradient(to bottom, transparent, black 20%, black 65%, transparent);
			animation: particle-drift 32s linear infinite;
		}

		.rain-layer {
			overflow: hidden;
			opacity: 0.9;
		}

		.rain-drop {
			position: absolute;
			top: -12%;
			width: 2px;
			background: linear-gradient(to bottom, transparent, rgb(110 231 183 / 0.95), transparent);
			filter: drop-shadow(0 0 4px rgb(52 211 153 / 0.6));
			animation-name: rain-fall;
			animation-duration: var(--duration);
			animation-delay: var(--delay);
			animation-timing-function: linear;
			animation-iteration-count: infinite;
		}

		.code-rain {
			position: fixed;
			top: -20vh;
			left: var(--left);
			width: 30px;
			color: rgb(110 231 183 / 0.92);
			font-family: 'JetBrains Mono', 'Courier New', monospace;
			font-size: 12px;
			line-height: 1.8;
			letter-spacing: 0.08em;
			white-space: nowrap;
			writing-mode: vertical-rl;
			text-shadow: 0 0 8px rgb(52 211 153 / 0.95), 0 0 18px rgb(52 211 153 / 0.55);
			animation-name: code-fall;
			animation-duration: var(--duration);
			animation-delay: var(--delay);
			animation-timing-function: linear;
			animation-iteration-count: infinite;
			z-index: 1;
			pointer-events: none;
		}

		@keyframes aurora-drift {
			0% { transform: translate3d(-8%, -4%, 0) rotate(-3deg); background-position: 0% 50%; }
			100% { transform: translate3d(8%, 5%, 0) rotate(4deg); background-position: 100% 50%; }
		}

		@keyframes grid-drift {
			from { background-position: 0 0; }
			to { background-position: 56px 56px; }
		}

		@keyframes particle-drift {
			from { background-position: 0 0, 35px 70px; }
			to { background-position: 130px 130px, -155px 260px; }
		}

		@keyframes rain-fall {
			0% { transform: translate3d(0, -15vh, 0) rotate(14deg); opacity: 0; }
			10% { opacity: 0.8; }
			85% { opacity: 0.35; }
			100% { transform: translate3d(-8vw, 125vh, 0) rotate(14deg); opacity: 0; }
		}

		@keyframes code-fall {
			0% { transform: translate3d(0, -20vh, 0); opacity: 0; }
			12% { opacity: 0.8; }
			80% { opacity: 0.35; }
			100% { transform: translate3d(-12px, 125vh, 0); opacity: 0; }
		}

		@media (prefers-reduced-motion: reduce) {
			.aurora-layer, .grid-layer, .particle-layer { animation: none; }
			.rain-drop, .code-rain { animation-duration: 8s; }
		}
	</style>
</BaseLayout>