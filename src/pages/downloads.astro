---
import BaseLayout from '../layouts/BaseLayout.astro';

const tools = [
  {
    name: "ツール名1",
    desc: "内容をここに記入。自作CLIツールの説明。",
    version: "v0.0.0",
    tags: ["Python", "CLI"],
    url: "#",
  },
  {
    name: "ツール名2",
    desc: "内容をここに記入。自作CLIツールの説明。",
    version: "v0.0.0",
    tags: ["C", "CLI"],
    url: "#",
  },
  {
    name: "ツール名3",
    desc: "内容をここに記入。自作CLIツールの説明。",
    version: "v0.0.0",
    tags: ["TypeScript"],
    url: "#",
  },
];

const downloadIcon = `<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" />`;
---

	<BaseLayout title="Downloads" activeNav="downloads">
		<main class="w-full max-w-full flex-1 px-4 sm:px-16 pt-10 sm:pt-14 pb-12 space-y-16 sm:space-y-20 overflow-x-hidden">

			<!-- 01 / 見出し -->
			<section class="w-full space-y-6" aria-label="ダウンロード紹介">
				<div class="flex items-center gap-4">
					<span class="text-xs font-mono text-emerald-400 font-semibold tracking-widest uppercase flex-shrink-0">01 / Downloads</span>
					<div class="h-[1px] w-full bg-gradient-to-r from-emerald-500/30 via-border/40 to-transparent"></div>
				</div>
				<p class="text-sm sm:text-base text-muted leading-relaxed max-w-3xl">
					In progress: ダウンロード配布ページ。
				</p>
			</section>

			<!-- 02 / ツール一覧 -->
			<section class="w-full space-y-6" aria-label="ツール一覧">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
					{tools.map((tool) => (
						<div class="rounded-2xl bg-surface border border-border p-5 space-y-4 hover:border-emerald-500/30 transition-colors flex flex-col justify-between">
							<div class="space-y-2">
								<div class="flex items-center justify-between gap-2">
									<h3 class="text-sm font-semibold text-text">{tool.name}</h3>
									<span class="text-[11px] font-mono text-muted flex-shrink-0">{tool.version}</span>
								</div>
								<p class="text-sm text-muted leading-relaxed">{tool.desc}</p>
								<div class="flex flex-wrap gap-1.5 pt-1">
									{tool.tags.map((tag) => (
										<span class="px-2.5 py-1 rounded-md bg-white/[0.03] border border-border text-xs text-muted font-mono">{tag}</span>
									))}
								</div>
							</div>
							<a href={tool.url} class="mt-2 inline-flex items-center justify-center gap-2 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-300 text-xs font-mono px-3 py-2 hover:bg-emerald-500/15 transition-colors">
								<span set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${downloadIcon}</svg>`} />
								Download
							</a>
						</div>
					))}
				</div>
			</section>

		</main>

	</BaseLayout>